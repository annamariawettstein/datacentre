# PostgreSQL + PostGIS connection string
DATABASE_URL=postgresql://localhost:5432/datacentre

# Classification / extraction LLM. Provider is inferred from whichever key is
# set (Gemini preferred); override with CLASSIFY_PROVIDER=gemini|anthropic.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# CLASSIFY_PROVIDER=gemini
# CLASSIFY_MODEL defaults to gemini-2.5-flash (gemini) or claude-haiku-4-5 (anthropic)
# CLASSIFY_MODEL=gemini-2.5-flash

# Contact string sent in the User-Agent to the PlanIt API (be a good citizen)
PLANIT_CONTACT=you@example.com
